{
  "name": "batas-aksi",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first preflight control plane for AI agent actions.",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm --filter @batasaksi/core build && pnpm --filter @batasaksi/cli build && pnpm --filter @batasaksi/studio build",
    "dev": "pnpm --filter @batasaksi/studio dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core/tsconfig.build.json packages/cli/tsconfig.build.json && tsc -p apps/studio/tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prebatasaksi": "pnpm --filter @batasaksi/core build && pnpm --filter @batasaksi/cli build",
    "batasaksi": "node packages/cli/dist/index.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
